# QQ 开放平台机器人凭据，仅用于本机运行
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 可选静态授权：Bot 私聊 senderId，逗号分隔。也可通过 npm run pair 配对。
# 两种授权都为空时拒绝控制消息；配对申请始终需要本机确认。
QQBOT_ALLOWED_USERS=
CODEX_ENABLED=true
# 留空自动选择；Windows 使用桌面 IPC，Linux/macOS 使用已有 socket 或本机 CLI
CODEX_SOCKET=
# CODEX_EXECUTABLE=C:/path/to/codex.exe
CLAUDE_ENABLED=true
# default 或 bypassPermissions；后者为 YOLO，新会话免权限确认
CLAUDE_PERMISSION_MODE=default
# CLAUDE_DEFAULT_CWD=C:/Projects
# CLAUDE_EXECUTABLE=C:/path/to/claude.exe
BOT_DATA_DIR=./data
BOT_POLL_MS=3000
QQBOT_KEYBOARDS=true
# 多机器属于进阶配置，可选
# BOT_MACHINES_FILE=./machines.json
