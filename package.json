{
  "name": "qq-agent-bot",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "setup": "node dist/src/setup.js",
    "pair": "node dist/src/pair.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "doctor": "node dist/src/doctor.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:claude": "tsx scripts/claude-smoke.ts",
    "service": "node dist/src/cli.js service",
    "menus": "node dist/scripts/menus.js",
    "export:source": "node scripts/export-source.mjs",
    "cli": "node dist/src/cli.js",
    "package:release": "node scripts/pack.mjs",
    "prepack": "npm run build",
    "smoke:install": "node scripts/npm-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "dotenv": "17.4.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "QQ private-chat interface for local Codex and Claude Code sessions",
  "repository": {
    "type": "git",
    "url": "https://github.com/wllevy/qq-agent-bot.git"
  },
  "homepage": "https://github.com/wllevy/qq-agent-bot#readme",
  "bugs": {
    "url": "https://github.com/wllevy/qq-agent-bot/issues"
  },
  "bin": {
    "qq-agent-bot": "bin/qq-agent-bot.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/src/*.js",
    "dist/scripts/menus.js",
    "scripts/supervisor.mjs",
    "scripts/launcher.mjs",
    "scripts/launcher.ps1",
    "scripts/windows-service.ps1",
    "scripts/install.ps1",
    "scripts/install.sh",
    "docs/",
    ".env.example",
    "scripts/npm-install.mjs",
    "SECURITY.md"
  ]
}
